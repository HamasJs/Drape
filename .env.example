# Copy to .env.local, add your key, and restart npm run dev.
# Never use NEXT_PUBLIC_ for an API key.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash

# Required for production accounts and cloud storage (Supabase project settings).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public URL, e.g. https://your-domain.com (no trailing path).
APP_URL=http://127.0.0.1:3000
